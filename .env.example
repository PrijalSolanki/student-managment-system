# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your environment.
#   cp .env.example .env        (Linux / macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# NEVER commit the real `.env` file to version control.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LANGUAGE_CODE=en-us

# --- Database (MySQL) ------------------------------------------------------
# DB_ENGINE=mysql  (default)  |  DB_ENGINE=sqlite (local experiments only)
DB_ENGINE=mysql
DB_NAME=sms_db
DB_USER=sms_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_SSL_MODE=

# --- Security --------------------------------------------------------------
# Set to True only when the app is served over HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Uploads / email -------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Demo seed data --------------------------------------------------------
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_STAFF_USERNAME=staff
DEMO_STAFF_PASSWORD=Staff@123
DEMO_STAFF_EMAIL=staff@example.com
SEED_STUDENT_COUNT=60
SEED_TEACHER_COUNT=12
